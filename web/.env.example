# Base URL for API requests (no trailing slash).
# Defaults to '/api' — works in dev via the Vite proxy, and in prod when
# the API is served behind the same origin. Override for a remote API.
# VITE_API_URL="/api"

# WebSocket URL for realtime updates. Defaults to same-origin with ws(s).
# VITE_WS_URL="ws://localhost:5173"
