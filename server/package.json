  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "hono": "^4.7.2",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.2",
    "@types/nodemailer": "^8.0.1",
    "prisma": "^6.5.0",
    "typescript": "~5.8.2"
  }
}
